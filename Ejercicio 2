import math
import ustruct
from machine import Pin, Timer
from utime import sleep_us
from i2cslave import I2CSlave

# Constantes de configuración
SLAVE_ADDR = 0x0A
ZX_PIN = 2
TRIAC_PIN = 3
BOARD_LED = 25  # LED integrado de la Pico

# Variables globales
power = 0.0
pdelay = 8200  # Retardo predeterminado en microsegundos (0% de potencia)
trigger_timer = Timer()

# Configuración de pines de salida
triac_pin = Pin(TRIAC_PIN, Pin.OUT)
triac_pin.value(0)

board_led = Pin(BOARD_LED, Pin.OUT)
board_led.value(0)

def calcular_pdelays(p):
    """Calcula el retardo exacto en microsegundos limitando los extremos problemáticos"""
    if p >= 99:
        return 200     # Máximo brillo seguro
    elif p <= 1:
        return 8200    # Apagado total seguro (evita zonas muertas de parpadeo)
    
    # Mapeo lineal suave
    retardo = int(8200 - (p / 100.0) * 7700)
    return max(300, min(8000, retardo))

def calcular_potencia_real(pdelay_us):
    """
    Calcula la potencia real modulada a partir del retardo en microsegundos,
    utilizando la ecuación de fase para 60Hz (periodo de semiciclo = 8333us).
    Ecuación (3): P% = (1 - alpha/pi + sin(2*alpha)/(2*pi)) * 100
    """
    # Si está completamente apagado
    if pdelay_us >= 8200:
        return 0.0
    # Si está completamente encendido
    elif pdelay_us <= 200:
        return 100.0

    # Semiciclo a 60Hz = 8.333 ms (8333 us) corresponde a pi radianes (180 grados)
    # alpha = (retardo_en_us / 8333.33) * pi
    alpha = (pdelay_us / 8333.33) * math.pi
    
    # Aplicando la fórmula de la práctica (Ecuación 3)[cite: 5]
    p_real = (1.0 - (alpha / math.pi) + (math.sin(2.0 * alpha) / (2.0 * math.pi))) * 100.0
    return max(0.0, min(100.0, p_real))

def enviar_pulso_triac(timer):
    """Dispara el triac de forma limpia"""
    triac_pin.value(1)
    sleep_us(30)
    triac_pin.value(0)

def zx_handle(pin):
    """Interrupción de cruce por cero corregida"""
    global pdelay
    # Apagamos el triac inmediatamente en el cruce por cero
    triac_pin.value(0)
    
    # Si no está apagado al 0%
    if pdelay < 8200:
        # Convertimos microsegundos a milisegundos con precisión de punto flotante para el Timer
        delay_ms = pdelay / 1000.0
        trigger_timer.init(mode=Timer.ONE_SHOT, period=int(delay_ms), callback=enviar_pulso_triac)

# Configuración de la interrupción por cruce por cero en GPIO2
zx_pin = Pin(ZX_PIN, Pin.IN, Pin.PULL_UP)
zx_pin.irq(trigger=Pin.IRQ_RISING | Pin.IRQ_FALLING, handler=zx_handle)

# Inicializar esclavo I2C (pines SDA=20, SCL=21)
i2c = I2CSlave(
    id=0,
    address=SLAVE_ADDR,
    sda=20,
    scl=21
)

print("Sistema de control de brillo I2C iniciado (Actividad 2)")
print("Direccion: 0x0A | SDA: GPIO20 | SCL: GPIO21")

# Bucle principal
while True:
    try:
        if i2c.rxBufferCount() >= 4:
            data = i2c.read()
            if len(data) == 4:
                power = ustruct.unpack('<f', data)[0]
                power = max(0.0, min(100.0, power))
                
                print(f"Potencia deseada recibida: {power:.2f}%")
                
                # Actualiza el retardo en microsegundos
                pdelay = calcular_pdelays(power)
                
                # Calcula la potencia real modulada en función del tiempo de encendido (retardo)
                potencia_real = calcular_potencia_real(pdelay)
                
                # Responder a la Raspberry Pi con la potencia REAL calculada
                respuesta = ustruct.pack('<f', potencia_real)
                i2c.write(respuesta)
        else:
            sleep_us(100)
            
    except Exception as e:
        print("Error en bucle I2C:", e)
